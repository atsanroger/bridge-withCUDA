# Template filled by make_run.sh (@KEY@ placeholders). eo-DWF (Mobius) CGNR.
Test_Spectrum:
  gauge_config_status      : Continue
  gauge_config_type_input  : @CTYPE@
  config_filename_input    : @CONF@
  random_number_type       : Mseries
  seed_for_random_number   : 1234567UL
  verbose_level            : General

Smearing:
  projection_type     : Stout_SU3
  smear_type          : APE
  rho_uniform         : 0.1
  number_of_smearing  : 0
  verbose_level       : General

Corr2pt_4spinor:
  filename_output : stdout
  verbose_level   : General

Fopr_ref:
  fermion_type            : Domainwall
  kernel_type             : Wilson
  gamma_matrix_type       : Dirac
  quark_mass              : @MQ@
  quark_mass_PauliVillars : 1.0
  domain_wall_height      : @M0@
  extent_of_5th_dimension : @LS@
  boundary_condition      : [1,1,1,-1]
  coefficient_b           : 1.5
  coefficient_c           : 0.5
  parameter_alpha         : 1.0
  verbose_level           : General

Fopr:
  fermion_type            : Domainwall_5din
  kernel_type             : Wilson
  gamma_matrix_type       : Dirac
  code_implementation     : 5d
  quark_mass              : @MQ@
  quark_mass_PauliVillars : 1.0
  domain_wall_height      : @M0@
  extent_of_5th_dimension : @LS@
  boundary_condition      : [1,1,1,-1]
  coefficient_b           : 1.5
  coefficient_c           : 0.5
  parameter_alpha         : 1.0
  verbose_level           : General

Source:
  source_type     : Local
  source_position : [0,0,0,0]
  slope           : 0.25
  power           : 2.0
  source_momentum : [1,1,1,0]
  verbose_level   : General

GaugeFixing:
  gauge_fixing_type             : None
  maximum_number_of_iteration   : 5000
  number_of_naive_iteration     : 50
  interval_of_measurement       : 10
  iteration_to_reset            : 1000
  convergence_criterion_squared : 1.0e-24
  overrelaxation_parameter      : 1.6
  verbose_level                 : General

Solver:
  solver_type                         : CGNR
  ## multiword_mode = {FP, lowendgpu, DW, TW}; field_type and extended_precision follow from it
  multiword_mode                      : @MW@
  maximum_number_of_iteration         : @MAXITER@
  maximum_number_of_restart           : @NRESTART@
  convergence_criterion_squared       : @TOL@
  number_of_orthonormal_vectors       : 2
  tolerance_for_DynamicSelection_of_L : 0.1
  verbose_level                       : General
